FROM node:24.22.2-alpine3.24@sha256:a34ab6d7f6f4813f4d0c5469d74685604b962fbdbf5793a7bc7b4998ecb867c8 AS frontend

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

COPY public ./public
COPY resources ./resources
COPY tsconfig.json vite.config.js ./
RUN npm run build

FROM php:8.4.27-fpm-bookworm@sha256:b75642e8c89c321039f351466134df951576fb0f7017117b3931e9a19b908d6c AS app

ARG SOURCE_REVISION=unknown
LABEL org.opencontainers.image.source="https://github.com/cliophate/disco" \
      org.opencontainers.image.revision=$SOURCE_REVISION

RUN apt-get update \
    && apt-get install -y --no-install-recommends libjpeg62-turbo-dev libonig-dev libpng-dev libpq-dev libwebp-dev libzip-dev \
    && docker-php-ext-configure gd --with-jpeg --with-webp \
    && docker-php-ext-install -j2 gd mbstring opcache pcntl pdo_pgsql zip \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2@sha256:af98f42dfff7c68ba8d53c2164fd9fde1087b7d449514baa38c418b1f6bc4bac /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

COPY composer.json composer.lock ./
COPY docker/php/prepare-dist.php /tmp/prepare-dist.php
# Use GitHub's archive host directly; keep the locked source commit.
RUN php /tmp/prepare-dist.php composer.lock \
    && rm /tmp/prepare-dist.php \
    && composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --no-scripts \
    --prefer-dist

COPY . .
COPY --from=frontend /app/public/build ./public/build
COPY docker/php/php.production.ini /usr/local/etc/php/conf.d/99-disco-production.ini

RUN composer dump-autoload --no-dev --classmap-authoritative --no-interaction --no-scripts \
    && rm -f bootstrap/cache/*.php \
    && APP_ENV=local php artisan package:discover --ansi \
    && mkdir -p storage/app/artwork storage/app/private storage/app/public storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache

USER www-data

FROM nginx:1.30.6-alpine@sha256:970364228b1e4f932abc22d321932816782cca8a20b85a77552a7cfe9acfb3b5 AS web

ARG SOURCE_REVISION=unknown
LABEL org.opencontainers.image.source="https://github.com/cliophate/disco" \
      org.opencontainers.image.revision=$SOURCE_REVISION

COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=app /var/www/html/public /var/www/html/public

EXPOSE 8080
