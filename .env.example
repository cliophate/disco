APP_NAME=Disco
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=UTC
TRUSTED_PROXIES=127.0.0.1,::1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=disco
DB_USERNAME=disco
DB_PASSWORD=disco-local-only

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=180

CACHE_STORE=redis
CACHE_PREFIX=disco_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=56379

PLEX_URL=
PLEX_TOKEN=
PLEX_LIBRARY_NAME=Music
PLEX_EXPECTED_MACHINE_IDENTIFIER=
PLEX_EXPECTED_LIBRARY_UUID=
PLEX_ALLOW_INSECURE_HTTP=false
PLEX_TIMEOUT_SECONDS=30
PLEX_PLAYBACK_CONTEXT_TTL_SECONDS=120
PLEX_PLAYBACK_RECENT_DAYS=90
PLEX_MAX_CONCURRENT_STREAMS=2
COVER_ART_ARCHIVE_RELEASE_ATTEMPT_LIMIT=5
COVER_ART_ARCHIVE_MISSING_TTL_DAYS=30
COVER_ART_ARCHIVE_RETRY_TTL_HOURS=24

DISCOGS_TOKEN=
DISCOGS_URL=https://api.discogs.com
DISCOGS_TIMEOUT_SECONDS=20
DISCOGS_RATE_INTERVAL_MS=1100
DISCOGS_USER_AGENT="Disco/0.1 (https://github.com/cliophate/disco)"

LISTENBRAINZ_USERNAME=
LISTENBRAINZ_TOKEN=
LISTENBRAINZ_URL=https://api.listenbrainz.org
LISTENBRAINZ_TIMEOUT_SECONDS=30
LISTENBRAINZ_PAGE_SIZE=1000
LISTENBRAINZ_OVERLAP_SECONDS=3600
LISTENBRAINZ_RATE_INTERVAL_MS=250
LISTENBRAINZ_RECOMMENDATION_COUNT=500
LISTENBRAINZ_RECOMMENDATION_LIMIT=50
LISTENBRAINZ_RECOMMENDATION_LOOKUP_BUDGET=100
UPCOMING_STALE_AFTER_HOURS=36
UPCOMING_NOTIFICATION_MAX_ITEMS=5000
UPCOMING_NOTIFICATION_MISSING_THRESHOLD=2
GOTIFY_URL=
GOTIFY_TOKEN=
GOTIFY_TIMEOUT_SECONDS=10
GOTIFY_PRIORITY=5
DISCOGRAPHY_PAGE_SIZE=100
DISCOGRAPHY_MAX_PAGES=3
DISCOGRAPHY_OFFICIAL_RELEASE_MAX_PAGES=2
DISCOGRAPHY_STALE_AFTER_DAYS=90
PITCHFORK_RSS_ENABLED=false
PITCHFORK_RSS_CONNECT_TIMEOUT_SECONDS=5
PITCHFORK_RSS_TIMEOUT_SECONDS=15
PITCHFORK_RSS_MAXIMUM_BYTES=1000000
PITCHFORK_RSS_MAXIMUM_ITEMS=50
PITCHFORK_RSS_MAXIMUM_CARDS=6
PITCHFORK_RSS_EXPIRY_HOURS=72
PITCHFORK_RSS_RETENTION_DAYS=30
QOBUZ_STOREFRONT=us-en
THEAUDIODB_API_KEY=123
THEAUDIODB_RATE_INTERVAL_MS=2100
WIKIMEDIA_LANGUAGE=en

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
