APP_NAME=Disco
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
TRUSTED_PROXIES=127.0.0.1,::1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=disco
DB_USERNAME=disco
DB_PASSWORD=disco-local-only

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=180

CACHE_STORE=redis
CACHE_PREFIX=disco_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=56379

PLEX_URL=
PLEX_TOKEN=
PLEX_LIBRARY_NAME=Music
PLEX_EXPECTED_MACHINE_IDENTIFIER=
PLEX_EXPECTED_LIBRARY_UUID=
PLEX_ALLOW_INSECURE_HTTP=false
PLEX_TIMEOUT_SECONDS=30
COVER_ART_ARCHIVE_RELEASE_ATTEMPT_LIMIT=5
COVER_ART_ARCHIVE_MISSING_TTL_DAYS=30
COVER_ART_ARCHIVE_RETRY_TTL_HOURS=24


LISTENBRAINZ_USERNAME=
LISTENBRAINZ_TOKEN=
LISTENBRAINZ_URL=https://api.listenbrainz.org
LISTENBRAINZ_TIMEOUT_SECONDS=30
LISTENBRAINZ_PAGE_SIZE=1000
LISTENBRAINZ_OVERLAP_SECONDS=172800
LISTENBRAINZ_RATE_INTERVAL_MS=250
QOBUZ_STOREFRONT=us-en

DISCOVERY_BATCH_SIZE=10
DISCOVERY_SEED_LIMIT=30
DISCOVERY_RADIO_ARTIST_LIMIT=30
DISCOVERY_LIFETIME_LISTEN_THRESHOLD=5
DISCOVERY_REPEAT_WEEKS=12
DISCOVERY_SEED_CAP=2
DISCOVERY_POPULARITY_PENALTY=0.5
DISCOVERY_POPULAR_LISTENER_THRESHOLD=10000
DISCOVERY_FRESH_DAYS=30
DISCOVERY_ALBUM_LOOKUP_LIMIT=50

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
